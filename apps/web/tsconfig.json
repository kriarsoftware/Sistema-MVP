{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"], "allowJs": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve",
    "isolatedModules": true, "incremental": true, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "playwright.config.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
